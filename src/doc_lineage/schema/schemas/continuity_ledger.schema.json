{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stranske/Doc-Lineage/schemas/continuity_ledger.schema.json",
  "title": "continuity_ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_type",
    "transition",
    "canonical_section",
    "status",
    "words_current",
    "carry_forward_pct",
    "refresh_pct",
    "verbatim_words",
    "near_verbatim_words",
    "revised_words",
    "new_words",
    "dropped_words",
    "segments_verbatim",
    "segments_near",
    "segments_revised",
    "segments_new",
    "segments_dropped",
    "segments_cosmetic",
    "new_items",
    "dropped_items",
    "text_basis"
  ],
  "properties": {
    "doc_type": { "type": "string" },
    "transition": { "type": "string" },
    "canonical_section": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["VERBATIM", "NEAR_VERBATIM", "REVISED", "NEW", "DROPPED"]
    },
    "words_current": { "type": "integer" },
    "carry_forward_pct": { "type": "number", "minimum": 0 },
    "refresh_pct": { "type": "number", "minimum": 0 },
    "verbatim_words": { "type": "integer" },
    "near_verbatim_words": { "type": "integer" },
    "revised_words": { "type": "integer" },
    "new_words": { "type": "integer" },
    "dropped_words": { "type": "integer" },
    "segments_verbatim": { "type": "integer" },
    "segments_near": { "type": "integer" },
    "segments_revised": { "type": "integer" },
    "segments_new": { "type": "integer" },
    "segments_dropped": { "type": "integer" },
    "segments_cosmetic": { "type": "integer" },
    "new_items": { "type": "integer" },
    "dropped_items": { "type": "integer" },
    "text_basis": { "type": "string", "enum": ["native", "ocr", "mixed"] }
  }
}
